# 🔐 App Config
FLASK_ENV=production
SECRET_KEY=your-super-secret-key

# 🌐 App URL (optional but useful later)
BASE_URL=http://your-domain.com

# 🤖 Ollama Config
OLLAMA_URL=http://your-ollama-host:11434  # Use VPS IP or internal docker hostname

# ⚡ Model Defaults
DEFAULT_MODEL=phi3

# ⏱️ Timeout
REQUEST_TIMEOUT=120

# 🧠 Model Limits
MAX_TOKENS=200
TEMPERATURE=0.7